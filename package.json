{
  "name": "speedtobox",
  "version": "1.0.0",
  "private": true,
  "description": "SpeedToBox — Sistema Integrado de Gestão de Estoque & PDV",
  "scripts": {
    "dev": "concurrently --names BACKEND,FRONTEND --prefix-colors cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend -- -p 3000",
    "build:frontend": "npm run build --prefix frontend",
    "start:frontend": "npm run start --prefix frontend",
    "dev:backend": "cd backend && .\\venv\\Scripts\\uvicorn.exe app.main:app --reload --port 8000 --host 127.0.0.1",
    "test:backend": "cd backend && .\\venv\\Scripts\\python.exe -m pytest tests/ -v"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}

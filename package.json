{
  "name": "speedtobox",
  "version": "1.0.0",
  "private": true,
  "description": "SpeedToBox — Sistema Integrado de Gestão de Estoque & PDV",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "start:frontend": "npm run start --prefix frontend",
    "dev:backend": "powershell -Command \"Set-Location backend; .\\venv\\Scripts\\uvicorn app.main:app --reload --port 8000\"",
    "test:backend": "powershell -Command \"Set-Location backend; .\\venv\\Scripts\\python -m pytest tests/ -v\""
  }
}
